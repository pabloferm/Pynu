    <nuisance name='XSecNuTau'>
        <status> 1 </status>
        <sigma> 0.25 </sigma>
        <nominal> 1.0 </nominal>
        <distribution> normal </distribution>
    </nuisance>

    <nuisance name='NCoverCC'>
        <status> 1 </status>
        <sigma> 0.2 </sigma>
        <nominal> 1.0 </nominal>
        <distribution> normal </distribution>
    </nuisance>

    <nuisance name='AxialMass'>
        <status> 1 </status>
        <sigma> 0.03 </sigma>
        <nominal> 1.0 </nominal>
        <distribution> normal </distribution>
    </nuisance>

    <nuisance name='NCHad'>
        <status> 1 </status>
        <sigma> 0.1 </sigma>
        <nominal> 1.0 </nominal>
        <distribution> normal </distribution>
    </nuisance>

    <!-- Mode-dependent params (need interaction_type in parquet — regenerated) -->
    <nuisance name='DIS'>
        <status> 1 </status>
        <sigma> 0.05 </sigma>
        <nominal> 1.0 </nominal>
        <distribution> normal </distribution>
    </nuisance>

    <nuisance name='CCQE'>
        <status> 1 </status>
        <sigma> 0.1 </sigma>
        <nominal> 1.0 </nominal>
        <distribution> normal </distribution>
    </nuisance>

    <nuisance name='CCQENuBarNu'>
        <status> 1 </status>
        <sigma> 0.1 </sigma>
        <nominal> 1.0 </nominal>
        <distribution> normal </distribution>
    </nuisance>

    <nuisance name='CCQEMuE'>
        <status> 1 </status>
        <sigma> 0.1 </sigma>
        <nominal> 1.0 </nominal>
        <distribution> normal </distribution>
    </nuisance>

    <nuisance name='CC1PiProduction'>
        <status> 1 </status>
        <sigma> 0.2 </sigma>
        <nominal> 1.0 </nominal>
        <distribution> normal </distribution>
    </nuisance>

    <nuisance name='CohPiProduction'>
        <status> 1 </status>
        <sigma> 0.3 </sigma>
        <nominal> 1.0 </nominal>
        <distribution> normal </distribution>
    </nuisance>
</NeutrinoTarget>

<!-- IceCube DeepCore Detector Configuration -->
<NeutrinoExperiment name="IceCube-DeepCore">
    <status> 1 </status>
    <target name="Water"> </target>

    <source name='Atmospheric'>
        <status> 1 </status>
        <MCFiles name='/n/holylfs05/LABS/arguelles_delgado_lab/Everyone/miaochenjin/AtmNuDataFit/Pynu/data/IceCube/IC_MC.parquet'>
            <status> 1 </status>
        </MCFiles>
        <exposure> 7.74 </exposure>
        <MCexposure> 100.0 </MCexposure>
        <DataFiles name='/n/holylfs05/LABS/arguelles_delgado_lab/Everyone/miaochenjin/AtmNuDataFit/Pynu/data/IceCube/IC_data.parquet'>
            <status> 0 </status>
        </DataFiles>
    </source>

    <!-- IceCube detector systematics (hypersurface) -->
    <nuisance name='dom_eff'>
        <status> 1 </status>
        <sigma> 0.10 </sigma>
        <nominal> 1.0 </nominal>
        <distribution> normal </distribution>
    </nuisance>

    <nuisance name='hole_ice_p0'>
        <status> 1 </status>
        <sigma> 0.10 </sigma>
        <nominal> 0.10 </nominal>
        <distribution> normal </distribution>
    </nuisance>

    <nuisance name='hole_ice_p1'>
        <status> 1 </status>
        <sigma> 0.10 </sigma>
        <nominal> -0.05 </nominal>
        <distribution> normal </distribution>
    </nuisance>

    <nuisance name='bulk_ice_abs'>
        <status> 1 </status>
        <sigma> 0.10 </sigma>
        <nominal> 1.0 </nominal>
        <distribution> normal </distribution>
    </nuisance>

    <nuisance name='bulk_ice_scatter'>
        <status> 1 </status>
        <sigma> 0.10 </sigma>
        <nominal> 1.0 </nominal>
        <distribution> normal </distribution>
    </nuisance>

    <nuisance name='muon_norm'>
        <status> 0 </status>
        <sigma> 0.5 </sigma>
        <nominal> 1.0 </nominal>
        <distribution> normal </distribution>
    </nuisance>
</NeutrinoExperiment>

<!-- Physics: Standard 3-flavor Oscillations (CPT) -->
<NeutrinoOscillations name="3-Osc-CPT">
    <status> 1 </status>
    <flavors> 3 </flavors>

    <fixed name='Sin2Theta12'>
        <status> 1 </status>
