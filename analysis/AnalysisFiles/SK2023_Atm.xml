<?xml version="1.0" encoding="UTF-8"?>
<!--
Super-Kamiokande 2023 Atmospheric Neutrino Analysis Configuration

Uses SuperK_2023 experiment class (SuperK_Atm_Pheno.py) with
SKCombinedDetector tunes. MC file: SuperK_fullMC_6_4_x50_inv_flux_tune1.h5
(3.8M events, 29 samples, SK I-V combined).

MCexposure=50 matches the x50 in filename.
Detector systematics disabled initially (decay_e_tagging MUST stay disabled
since SuperK_2023.MCVariables does not set DecayE).
-->
<Analysis>

<!-- ======================================================================= -->
<!-- Atmospheric Flux Systematics -->
<!-- ======================================================================= -->
<NeutrinoSource name="Atmospheric">
    <status> 1 </status>

    <nuisance name='normalization_below1GeV'>
        <status> 1 </status>
        <sigma> 0.25 </sigma>
        <nominal> 1.0 </nominal>
        <distribution> normal </distribution>
    </nuisance>

    <nuisance name='normalization_above1GeV'>
        <status> 1 </status>
        <sigma> 0.15 </sigma>
        <nominal> 1.0 </nominal>
        <distribution> normal </distribution>
    </nuisance>

    <nuisance name='tilt'>
        <status> 1 </status>
        <sigma> 0.2 </sigma>
        <nominal> 0.0 </nominal>
        <distribution> normal </distribution>
    </nuisance>

    <nuisance name='nunubar_ratio'>
        <status> 1 </status>
        <sigma> 0.02 </sigma>
        <nominal> 1.0 </nominal>
        <distribution> normal </distribution>
    </nuisance>

    <nuisance name='flavor_ratio'>
        <status> 1 </status>
        <sigma> 0.05 </sigma>
        <nominal> 1.0 </nominal>
        <distribution> normal </distribution>
    </nuisance>

    <nuisance name='zenith_up'>
        <status> 1 </status>
        <sigma> 0.2 </sigma>
        <nominal> 0.0 </nominal>
        <distribution> normal </distribution>
    </nuisance>

    <nuisance name='zenith_down'>
        <status> 1 </status>
        <sigma> 0.2 </sigma>
        <nominal> 0.0 </nominal>
        <distribution> normal </distribution>
    </nuisance>
</NeutrinoSource>

<!-- ======================================================================= -->
<!-- Cross-Section Systematics (Water target) -->
<!-- ======================================================================= -->
<NeutrinoTarget name="Water">
    <status> 1 </status>

    <nuisance name='XSecNuTau'>
        <status> 0 </status>
        <sigma> 0.25 </sigma>
        <nominal> 1.0 </nominal>
        <distribution> normal </distribution>
    </nuisance>

    <nuisance name='NCoverCC'>
        <status> 0 </status>
        <sigma> 0.2 </sigma>
        <nominal> 1.0 </nominal>
        <distribution> normal </distribution>
    </nuisance>
</NeutrinoTarget>

<!-- ======================================================================= -->
<!-- Super-Kamiokande 2023 Detector Configuration -->
<!-- ======================================================================= -->
<NeutrinoExperiment name="SuperK Pheno 2023">
    <status> 1 </status>
    <target name="Water"> </target>

    <source name='Atmospheric'>
        <status> 1 </status>
        <!-- MC file: SK 2023 combined MC (3.8M events, x50 equivalent) -->
        <MCFiles name='/n/holylfs05/LABS/arguelles_delgado_lab/Everyone/miaochenjin/AtmNuDataFit/SuperK_fullMC_6_4_x50_inv_flux_tune1.h5'>
            <status> 1 </status>
        </MCFiles>
        <!-- Exposure in years (SK I-V combined ~22.5 kton-yr) -->
        <exposure> 1.0 </exposure>
        <!-- MCexposure: 50 (matches x50 in filename) -->
        <MCexposure> 50.0 </MCexposure>
        <!-- No data file (Asimov mode) -->
        <DataFiles name='none'>
            <status> 0 </status>
        </DataFiles>
    </source>

    <!-- Detector systematics: ALL DISABLED for initial validation -->
    <!-- WARNING: decay_e_tagging MUST remain disabled (status=0) because
         SuperK_2023.MCVariables() does not set experiment.DecayE -->

    <nuisance name='fiducial_volume'>
        <status> 0 </status>
        <sigma> 0.05 </sigma>
        <nominal> 1.0 </nominal>
        <distribution> normal </distribution>
    </nuisance>

    <nuisance name='energy_scale'>
        <status> 0 </status>
        <sigma> 0.03 </sigma>
        <nominal> 1.0 </nominal>
        <distribution> normal </distribution>
    </nuisance>

