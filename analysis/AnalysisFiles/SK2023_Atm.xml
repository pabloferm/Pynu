    </nuisance>

    <nuisance name='pc_stopthru_separation'>
        <status> 0 </status>
        <sigma> 0.05 </sigma>
        <nominal> 1.0 </nominal>
        <distribution> normal </distribution>
    </nuisance>

    <nuisance name='neutron_tagging'>
