        <nominal> 1.0 </nominal>
        <distribution> normal </distribution>
    </nuisance>

    <nuisance name='pc_reduction'>
        <status> 0 </status>
        <sigma> 0.05 </sigma>
        <nominal> 1.0 </nominal>
        <distribution> normal </distribution>
    </nuisance>

    <nuisance name='singlering_pid'>
        <status> 0 </status>
        <sigma> 0.05 </sigma>
        <nominal> 1.0 </nominal>
        <distribution> normal </distribution>
    </nuisance>

    <nuisance name='multiring_pid'>
        <status> 0 </status>
        <sigma> 0.05 </sigma>
        <nominal> 1.0 </nominal>
