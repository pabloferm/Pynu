    <!-- ===================================================================== -->
    <!-- Native binned-tensor engine opt-in (pynu.binned). Default-OFF: this    -->
    <!-- <BinnedEngine> block is INVISIBLE to ParseXML and is read only by      -->
    <!-- pynu/analysis_reader/binned_config.py:parse_binned_config. status=1 →    -->
    <!-- routes to FitModelBinned, which fits each (Dm231, Sin2Theta23) grid    -->
    <!-- point with the engine's dCP-profiled L-BFGS-B minimizer on pre-built   -->
    <!-- oscillation tensors (no per-point nuSQuIDS in the fit loop).           -->
    <!--                                                                        -->
    <!-- ${SK_BINNED_DIR} is expanded at parse time. The <response> npz carries -->
    <!-- the observed data vector + sample table; the engine (not this XML's    -->
    <!-- DataFiles) owns the observation in binned mode.                        -->
    <!--                                                                        -->
    <!-- nuisance_spec: the engine owns the dial set (nominal/sigma/box/grad).  -->
    <!-- A named spec ('barr' = production 41+ baseline) is authoritative; the  -->
    <!-- XML-active nuisances above are CROSS-CHECKED against the engine's      -->
    <!-- CANONICAL_DIALS (mismatches warn; the engine value wins).              -->
    <!--                                                                        -->
    <!-- interp='nodes' does an EXACT grid-node lookup, so the <physics> grid   -->
    <!-- points/edges below MUST match the tensor build's node axes (here the   -->
    <!-- 15x15 skb2p2h grid: Dm231 15pts in [2.0,3.5]e-3, Sin2Theta23 15pts in  -->
    <!-- [0.40,0.80]). Use interp='cubic' for off-node queries (within the      -->
    <!-- gate-validated safe band).                                             -->
    <!--                                                                        -->
    <!-- osc_averaging: PROVENANCE declaration of the fast-oscillation          -->
    <!-- averaging BAKED INTO the tensor build (off | 4pi | <float>). The       -->
    <!-- production baseline uses the scale-4pi averaged solmin tensors          -->
    <!-- (sk_binned_avg4pi_20x20x20), so declare 4pi; the load path records it   -->
    <!-- into the fit sidecar and warns only if a future tensor set's embedded   -->
    <!-- metadata disagrees (current sets carry none).                          -->
    <BinnedEngine>
        <status> 1 </status>
        <response> ${SK_BINNED_DIR}/sk_response.npz </response>
        <tensors> ${SK_BINNED_DIR}/osc_tensors </tensors>
        <likelihood> poisson </likelihood>
        <migration> weighted </migration>
        <nuisance_spec> barr </nuisance_spec>
        <interp> nodes </interp>
        <osc_averaging> 4pi </osc_averaging>
    </BinnedEngine>

</NeutrinoExperiment>

<!-- ======================================================================= -->
<!-- Physics Scenario: Standard 3-flavor Oscillations -->
<!-- ======================================================================= -->
<NeutrinoOscillations name="3-Osc">
    <status> 1 </status>
    <flavors> 3 </flavors>

    <!-- Fixed parameters -->
    <fixed name='Sin2Theta12'>
        <status> 1 </status>
        <value> 0.303 </value>
    </fixed>

    <fixed name='Sin2Theta13'>
        <status> 1 </status>
        <value> 0.022 </value>
    </fixed>

    <fixed name='Dm221'>
        <status> 1 </status>
        <value> 7.41e-5 </value>
    </fixed>

    <fixed name='dCP'>
        <status> 1 </status>
        <value> 1.36 </value>
    </fixed>

    <!-- 2D (Dm231, Sin2Theta23) scan. interp='nodes' requires these points/edges
         to match the tensor build's node axes (here 15x15 skb2p2h). -->
    <physics name='Dm231'>
        <points> 15 </points>
        <min> 2.0e-3 </min>
        <max> 3.5e-3 </max>
        <true> 2.511e-3 </true>
    </physics>

    <physics name='Sin2Theta23'>
        <points> 15 </points>
        <min> 0.40 </min>
        <max> 0.80 </max>
        <true> 0.572 </true>
    </physics>

    <physics name='Ordering'>
        <points> 1 </points>
        <min> normal </min>
        <max> normal </max>
        <true> normal </true>
    </physics>
</NeutrinoOscillations>

</Analysis>
