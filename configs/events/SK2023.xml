<?xml version="1.0" encoding="UTF-8"?>
<!-- Build-stage analysis file for Super-Kamiokande: the MC and observed counts, the
     exposures, and the oscillation point at which the event framework is evaluated when
     it is constructed. Fit parameters live in configs/SK.xml and configs/Combined.xml.
     ${SK_MC} and ${SK_DATA} are filled by pynu.build.events.render_event_xml. -->
<Analysis>

<NeutrinoExperiment name="SuperK_pheno_2023">
    <source name="Atmospheric">
        <MCFiles name="${SK_MC}"> </MCFiles>
        <exposure> 1.0 </exposure>
        <MCexposure> 100.0 </MCexposure>
        <DataFiles name="${SK_DATA}"> </DataFiles>
    </source>
</NeutrinoExperiment>

<NeutrinoOscillations>
    <flavors> 3 </flavors>

    <fixed name="Sin2Theta12">
        <value> 0.303 </value>
    </fixed>

    <fixed name="Sin2Theta13">
        <value> 0.022 </value>
    </fixed>

    <fixed name="Sin2Theta23">
        <value> 0.572 </value>
    </fixed>

    <fixed name="Dm221">
        <value> 7.41e-5 </value>
    </fixed>

    <fixed name="dCP">
        <value> 1.36 </value>
    </fixed>

    <fixed name="Dm231">
        <value> 2.511e-3 </value>
    </fixed>
</NeutrinoOscillations>

</Analysis>
