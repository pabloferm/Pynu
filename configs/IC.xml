    <dial name="CC1Pi_NuBarNuMu" nominal="1.0" sigma="0.1" lo="0.5" hi="1.5"/>
    <dial name="xsec_ccqe_shape" nominal="1.0" sigma="0.2" lo="1.0" hi="1.0" pinned="true"/>
    <dial name="xsec_ccqe_shape_subgev" nominal="0.0" sigma="0.4" lo="-2.0" hi="2.0"/>
    <dial name="xsec_ccqe_multigev_nue" nominal="1.0" sigma="0.25" lo="0.01" hi="2.25"/>
    <dial name="xsec_ccqe_multigev_numu" nominal="1.0" sigma="0.25" lo="0.01" hi="2.25"/>
    <dial name="dom_eff" nominal="1.0" sigma="0.1" lo="0.5" hi="1.5"/>
    <dial name="hole_ice_p0" nominal="0.1" sigma="0.1" lo="0.01" hi="0.6"/>
    <dial name="hole_ice_p1" nominal="-0.05" sigma="0.1" lo="-0.55" hi="0.45"/>
    <dial name="bulk_ice_abs" nominal="1.0" sigma="0.1" lo="0.5" hi="1.5"/>
    <dial name="bulk_ice_scatter" nominal="1.0" sigma="0.1" lo="0.5" hi="1.5"/>
    <dial name="xsec_ccqe_shape_multigev" nominal="0.0" sigma="0.2" lo="-1.0" hi="1.0"/>
  </dials>
  <reference ordering="NO" cell="25,21,17" chi2="208.08794643065673" tol="0.0005" tol_rebuilt="0.1" note="published NO best fit"/>
  <reference ordering="IO" cell="15,20,6" chi2="209.78757765437436" tol="0.0005" tol_rebuilt="0.1" note="published IO best fit"/>
</binned_scan>
