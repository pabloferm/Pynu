<?xml version="1.0" encoding="utf-8"?>
<!--
  Super-Kamiokande + IceCube-DeepCore + KM3NeT/ORCA6 combined fit: Delta chi^2
  lattice scan of record (the paper's combined result).

  Fit vector  the dials below, in this order: 47 shared slots (block="shared"; one
              Gaussian prior each, bounds nominal +- 5 sigma with floor 0.01) followed by
              104 SK-only slots (block="sk"; the SK engine's prior and box).
              "experiments" says which engines a shared slot feeds.
  chi^2       chi^2_IC + chi^2_ORCA + chi^2_SK + prior(shared). SK's engine prior on the
              shared slots is switched off (width 1e12) so each is penalised once.
  Protocol    per lattice cell, delta_CP nodes 0..19 in order; each node is one L-BFGS-B
              fit over all three engines plus 1 restart kept if lower, seeded from the
              previous node (the first node from "start").
  Region      20 x 20 cells around each ordering's best fit, all 20 delta_CP nodes.
  ORCA        oscillation tensors averaged over 5 sub-energies per bin (avg5).
-->
<binned_scan name="Combined" experiments="SK IC ORCA">
  <inputs>
    <input key="sk_response" path="${PYNU_WORK}/sk/sk_response_Ninv.npz" md5="eae268499fff134b607ebe1690993640"/>
    <input key="sk_fluxq" path="${PYNU_WORK}/fluxq/fluxq_sk.npz" md5="e983943e7d0cf84ecd10b660c1b29371"/>
    <input key="sk_tensors" path="${PYNU_WORK}/tensors/sk/{ordering}"/>
    <input key="ic_response" path="${PYNU_WORK}/ic/ic_response_modeaxis_L3.npz" md5="1b2008a9918a8b1541eeb3fd245921fd"/>
    <input key="ic_aux" path="${PYNU_WORK}/ic/ic_aux.npz"/>
    <input key="ic_fluxq" path="${PYNU_WORK}/fluxq/fluxq_ic.npz"/>
    <input key="ic_tensors" path="${PYNU_WORK}/tensors/ic/{ordering}"/>
    <input key="orca_response" path="${PYNU_WORK}/orca/orca_response_flat900.npz" md5="febf4f2b139f214b0e8a559afce2f68c"/>
    <input key="orca_aux" path="${PYNU_WORK}/orca/orca_aux.npz"/>
    <input key="orca_fluxq" path="${PYNU_WORK}/fluxq/fluxq_orca.npz"/>
    <input key="orca_tensors" path="${PYNU_WORK}/tensors/orca/{ordering}"/>
  </inputs>
  <lattice dm31_min="0.0016" dm31_max="0.003" n_dm31="41" s23_min="0.3" s23_max="0.7" n_s23="41" n_dcp="20" dm21="7.41e-05" sin2theta13="0.022"/>
  <region ordering="NO" i_dm31="15-34" i_s23="12-31" dcp_nodes="0-19"/>
  <region ordering="IO" i_dm31="8-27" i_s23="12-31" dcp_nodes="0-19"/>
