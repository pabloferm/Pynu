		<nuisance name='nunubar_ratio'>
			<status> 1 </status>
			<sigma> 0.05 </sigma>
			<nominal> 1.0 </nominal>
			<distribution> normal </distribution>
		</nuisance>
		<nuisance name='flavor_ratio'>
			<status> 1 </status>
			<sigma> 0.02 </sigma>
			<nominal> 1.0 </nominal>
