<Analysis>

<!--Anything common to a given neutrino source-->

<!-- Atmospheric neutrinos -->
	<NeutrinoSource name="Atmospheric">
		<status> 1 </status>
        <physics name='normalization_below1GeV'>
			<points> 11 </points>
			<min> 0.6 </min>
