<?xml version="1.0" encoding="UTF-8"?>
<Analysis>

	<Method name="Binned grid-search and profiling">
		<minimizer name="L-BFGS-B"> </minimizer>
		<verbosity> 1 </verbosity>
		<gradient> 1 </gradient>
		<max_tolerance> 1e-4 </max_tolerance>
		<min_tolerance> 1e-6 </min_tolerance>
		<tolerance_threshold> 5e2 </tolerance_threshold>

	</Method>

	<Method name="Binned inference">
		<sampler name="HMC"> </sampler>
		<verbosity> 1 </verbosity>
		<num_samples> 1e-4 </num_samples>
		<burn_in> 1e-6 </burn_in>
		<leapfrog_epsilon> 1e-6 </leapfrog_epsilon>
		<leapfrog_steps> 1e-6 </leapfrog_steps>

	</Method>

<!--Anything common to a given neutrino source-->
<!-- Atmospheric neutrinos -->
	<NeutrinoSource name="Atmospheric">
		<status> 1 </status>
        <nuisance name='normalization_above1GeV'>
			<status> 1 </status>
			<sigma> 0.1 </sigma>
			<nominal> 1.0 </nominal>
			<distribution> normal </distribution>
		</nuisance>
		<nuisance name='nunubar_ratio'>
			<status> 1 </status>
			<sigma> 0.05 </sigma>
			<nominal> 1.0 </nominal>
			<distribution> normal </distribution>
		</nuisance>
		<nuisance name='flavor_ratio'>
			<status> 1 </status>
			<sigma> 0.02 </sigma>
			<nominal> 1.0 </nominal>
			<distribution> normal </distribution>
		</nuisance>
		<physics name='tilt'>
			<points> 9 </points>
			<min> 0.9 </min>
			<max> 1.1 </max>
			<true> 1.0 </true>
		</physics>
	</NeutrinoSource>
<!-- Accelerator neutrinos -->
	<NeutrinoSource name="Accelerator">
		<status> 0 </status>
        <nuisance name='normalization'>
			<status> 1 </status>
			<sigma> 0.25 </sigma>
			<nominal> 1.0 </nominal>
			<distribution> normal </distribution>
		</nuisance>
		<nuisance name='flavor_ratio'>
			<status> 1 </status>
			<sigma> 0.25 </sigma>
			<nominal> 1.0 </nominal>
			<distribution> normal </distribution>
		</nuisance>
		<fixed name='tilt'>
			<status> 1 </status>
			<value> 1.2 </value>
		</fixed>
	</NeutrinoSource>
